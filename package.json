{
  "name": "security-audit-harness",
  "version": "0.1.0",
  "description": "Standalone LLM-driven white-box security audit harness",
  "type": "module",
  "license": "MIT",
  "bin": {
    "security-audit": "./bin/security-audit.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "validate": "bun skills/security-audit/scripts/validate-sarif.ts",
    "merge": "bun skills/security-audit/scripts/merge-sarif.ts",
    "report": "bun skills/security-audit/scripts/report-sarif.ts",
    "rules": "bun skills/security-audit/scripts/validate-sarif.ts --rules",
    "init": "bun bin/security-audit.ts init"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
